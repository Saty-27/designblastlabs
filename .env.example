# Public site URL used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://designblastlabs.com

# Optional: forward booking + newsletter submissions as JSON to a webhook (Zapier, Make, n8n, CRM…).
BOOKING_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# Optional: Google AI Studio key on a billed project — enables `npm run assets:gemini`.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── Where form submissions are stored ─────────────────────────
# On a VPS, point this OUTSIDE the deploy folder so a redeploy can't erase
# your enquiries. Create it once and make it writable by the app's user:
#   sudo mkdir -p /var/lib/designblastlabs
#   sudo chown $USER /var/lib/designblastlabs
# Leave blank in local development (defaults to ./.data).
DATA_DIR=

# ── Admin panel (/admin) ──────────────────────────────────────
# Username and password you type at /admin/login. Both required.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string signing the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs you out everywhere.
ADMIN_SESSION_SECRET=
